{
  "name": "fieldops-dashboard",
  "private": true,
  "version": "2.6.0",
  "type": "module",
  "scripts": {
    "metadata:sync": "node scripts/sync-product-metadata.mjs",
    "metadata:check": "node scripts/sync-product-metadata.mjs --check",
    "dev": "set NODE_ENV=development&& tsx server.ts",
    "p533:provision": "node scripts/p533-assets.mjs",
    "p533:verify": "node scripts/p533-assets.mjs --verify-only",
    "p533:verify:dist": "node scripts/p533-assets.mjs --verify-only --bundle=dist/p533",
    "build": "npm run metadata:check && npm run p533:verify && node scripts/p533-assets.mjs --prepare-public && vite build && npm run p533:verify:dist && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild server/p533Worker.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/p533Worker.cjs",
    "start": "node dist/server.cjs",
    "test": "npm run metadata:check && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "npm run typecheck"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/adm-zip": "^0.5.8",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "mqtt": "^5.15.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
