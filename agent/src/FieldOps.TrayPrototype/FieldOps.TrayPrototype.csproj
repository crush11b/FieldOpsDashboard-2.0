<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FieldOps.TrayPrototype</AssemblyName>
    <RootNamespace>FieldOps.TrayPrototype</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
    <PackageReference Include="System.Threading.AccessControl" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FieldOps.NativeHealth\FieldOps.NativeHealth.csproj" />
    <ProjectReference Include="..\FieldOps.ServiceControlPrototype\FieldOps.ServiceControlPrototype.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FieldOps.TrayPrototype.Tests" />
  </ItemGroup>

</Project>
